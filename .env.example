# ============================================================
# ARBRAIN
# ============================================================

ARBRAIN_BASE_URL=https://URL-DA-API-ARBRAIN
ARBRAIN_API_KEY=SUBSTITUA_PELA_CHAVE_ARBRAIN
ARBRAIN_DATA_ID=SUBSTITUA_PELO_DATA_ID
ARBRAIN_TIMEOUT_SECONDS=30


# ============================================================
# POSTGRESQL
# ============================================================

DATABASE_URL=postgresql://USUARIO:SENHA@HOST:5432/NOME_DO_BANCO


# ============================================================
# BOTNEXT
# ============================================================

BOTNEXT_BASE_URL=https://api.wts.chat/chat

# Informe somente o token, sem escrever "Bearer".
BOTNEXT_API_TOKEN=SUBSTITUA_PELO_TOKEN_BOTNEXT

# UUID da empresa cadastrada no BotNext.
BOTNEXT_COMPANY_ID=SUBSTITUA_PELO_UUID_DA_EMPRESA

# Número do canal remetente.
# Formato: 55 + DDD + número, utilizando somente dígitos.
BOTNEXT_FROM=5541999999999

# Número autorizado para testes.
# Formato: 55 + DDD + número, utilizando somente dígitos.
BOTNEXT_TEST_TO=5541988888888

# ID do template cadastrado no BotNext.
BOTNEXT_TEMPLATE_ID=SUBSTITUA_PELO_ID_DO_TEMPLATE

# Variáveis do template em JSON.
# Mantenha {} quando o template não possuir parâmetros.
BOTNEXT_TEMPLATE_PARAMETERS_JSON={}

# Impede envios de mensagens para o cliente enquanto estiver false.
# Abrange o envio via template e as respostas de texto livre do fluxo de
# pedido (Etapa 3.2). Flag SEPARADA de BOTNEXT_PEDIDO_DISPATCH_ENABLED.
BOTNEXT_SEND_ENABLED=false

# Restringe os envios ao número definido em BOTNEXT_TEST_TO.
BOTNEXT_TEST_MODE=true


# ============================================================
# WEBHOOK BOTNEXT
# ============================================================

# Porta utilizada pelo receptor do webhook.
BOTNEXT_WEBHOOK_PORT=3333

# Segredo com exatamente 64 caracteres hexadecimais.
# Gere um segredo diferente para cada ambiente.
BOTNEXT_WEBHOOK_SECRET=SUBSTITUA_POR_64_CARACTERES_HEXADECIMAIS


# ============================================================
# REDIS / BULLMQ
# ============================================================

# Desenvolvimento local:
REDIS_URL=redis://127.0.0.1:6379

# Exemplo de produção:
# REDIS_URL=redis://USUARIO:SENHA@HOST:6379


# ============================================================
# OPENAI
# ============================================================

OPENAI_API_KEY=SUBSTITUA_PELA_CHAVE_OPENAI
OPENAI_MODEL=gpt-5-nano

# Mantém a classificação por IA desligada por segurança.
BOTNEXT_AI_ENABLED=false

# Confiança mínima entre 0 e 1.
AI_MIN_CONFIDENCE=0.80


# ============================================================
# DISPATCH PEDIDO CONFIRMADO (n8n)
# ============================================================

# Bloqueia o envio do PEDIDO_CONFIRMADO_V1 por padrão.
# Flag SEPARADA de BOTNEXT_SEND_ENABLED (envios ao cliente no BotNext),
# de BOTNEXT_AI_ENABLED (extração) e da confirmação de pedido (deteminística).
BOTNEXT_PEDIDO_DISPATCH_ENABLED=false

# Webhook alvo do n8n (somente via env — nunca hardcoded).
BOTNEXT_PEDIDO_DISPATCH_URL=

# Timeout do POST em milissegundos.
BOTNEXT_PEDIDO_DISPATCH_TIMEOUT_MS=10000

# Limite de tentativas transitórias (5xx/erro de rede).
BOTNEXT_PEDIDO_DISPATCH_MAX_ATTEMPTS=3