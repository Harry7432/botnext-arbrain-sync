generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SyncRunStatus {
  RUNNING
  SUCCESS
  FAILED
}

model Tenant {
  id            String  @id @default(uuid()) @db.Uuid
  name          String
  slug          String  @unique
  arbrainDataId Int     @map("arbrain_data_id")
  active        Boolean @default(true)

  clientes                         Cliente[]
  produtos                         Produto[]
  cervejas                         Cerveja[]
  pagamentos                       Pagamento[]
  syncRuns                         SyncRun[]
  syncCursors                      SyncCursor[]
  bancos                           Banco[]
  empresas                         Empresa[]
  botnextWebhookEvents             BotnextWebhookEvent[]
  botnextAccounts                  BotnextAccount[]
  botnextConversations             BotnextConversation[]
  botnextPedidoExtracao            BotnextPedidoExtracao[]
  botnextPedidoRascunho            BotnextPedidoRascunho[]
  botnextOutboundMessages          BotnextOutboundMessage[]
  botnextPedidoConfirmadoSnapshots BotnextPedidoConfirmadoSnapshot[]
  produtoAliases                   ProdutoAlias[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("tenants")
}

model Cliente {
  id        String @id @default(uuid()) @db.Uuid
  tenantId  String @map("tenant_id") @db.Uuid
  arbrainId String @map("arbrain_id")
  sku       Int

  tipo                      String?
  identificador             String?
  numeroDocumento           String? @map("numero_documento")
  razaoSocial               String? @map("razao_social")
  nomeFantasia              String? @map("nome_fantasia")
  clienteConsumidorFinal    Boolean @default(false) @map("cliente_consumidor_final")
  inscricaoEstadual         String? @map("inscricao_estadual")
  modalidade                String?
  uf                        String?
  cep                       String?
  cidade                    String?
  bairro                    String?
  logradouro                String?
  numero                    String?
  complemento               String?
  telefone                  String?
  celular                   String?
  email                     String?
  nomeResponsavel           String? @map("nome_responsavel")
  diaVisitaPrimario         String? @map("dia_visita_primario")
  diaVisitaSecundario       String? @map("dia_visita_secundario")
  periodicidadeDaVisita     String? @map("periodicidade_da_visita")
  ordenacaoDaVisita         String? @map("ordenacao_da_visita")
  indexSequenciamentoVisita Int?    @map("index_sequenciamento_visita")
  informacoesComplementares String? @map("informacoes_complementares")
  dataNascimento            String? @map("data_nascimento")
  descontoPadrao            Float   @default(0) @map("desconto_padrao")
  limiteDeCredito           Float   @default(0) @map("limite_de_credito")
  segmentacao               String?
  idGrupoCliente            String? @map("id_grupo_cliente")
  idTabelaPrecoPrimaria     String? @map("id_tabela_preco_primaria")
  idTabelaPrecoSecundaria   String? @map("id_tabela_preco_secundaria")
  idCondicaoPagamentoPadrao String? @map("id_condicao_pagamento_padrao")
  idVendedor                String? @map("id_vendedor")
  clienteAtivo              Boolean @default(false) @map("cliente_ativo")
  clienteBloqueado          Boolean @default(false) @map("cliente_bloqueado")
  preCadastro               Boolean @default(false) @map("pre_cadastro")

  syncedAt    DateTime @map("synced_at")
  lastSeenAt  DateTime @map("last_seen_at")
  payloadHash String?  @map("payload_hash")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant                           Tenant                            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  botnextWebhookEvents             BotnextWebhookEvent[]
  botnextConversations             BotnextConversation[]
  botnextOutboundMessages          BotnextOutboundMessage[]
  botnextPedidoConfirmadoSnapshots BotnextPedidoConfirmadoSnapshot[]

  @@unique([tenantId, arbrainId])
  @@unique([tenantId, sku])
  @@unique([tenantId, id])
  @@index([tenantId, clienteAtivo])
  @@index([tenantId, clienteBloqueado])
  @@index([tenantId, diaVisitaPrimario])
  @@index([tenantId, diaVisitaSecundario])
  @@map("clientes")
}

model Produto {
  id        String @id @default(uuid()) @db.Uuid
  tenantId  String @map("tenant_id") @db.Uuid
  arbrainId String @map("arbrain_id")
  sku       Int
  nome      String

  syncedAt    DateTime @map("synced_at")
  lastSeenAt  DateTime @map("last_seen_at")
  payloadHash String?  @map("payload_hash")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  aliases ProdutoAlias[]

  @@unique([tenantId, arbrainId])
  @@unique([tenantId, sku])
  @@unique([tenantId, id])
  @@index([tenantId, nome])
  @@map("produtos")
}

model Cerveja {
  id        String @id @default(uuid()) @db.Uuid
  tenantId  String @map("tenant_id") @db.Uuid
  arbrainId String @map("arbrain_id")
  sku       Int
  nome      String

  syncedAt    DateTime @map("synced_at")
  lastSeenAt  DateTime @map("last_seen_at")
  payloadHash String?  @map("payload_hash")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, arbrainId])
  @@unique([tenantId, sku])
  @@index([tenantId, nome])
  @@map("cervejas")
}

model Pagamento {
  id        String @id @default(uuid()) @db.Uuid
  tenantId  String @map("tenant_id") @db.Uuid
  arbrainId String @map("arbrain_id")
  sku       Int
  nome      String

  possuiVinculoBancario Boolean @map("possui_vinculo_bancario")

  syncedAt    DateTime @map("synced_at")
  lastSeenAt  DateTime @map("last_seen_at")
  payloadHash String?  @map("payload_hash")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, arbrainId])
  @@index([tenantId, sku])
  @@index([tenantId, nome])
  @@index([tenantId, possuiVinculoBancario])
  @@map("pagamentos")
}

model Banco {
  id        String @id @default(uuid()) @db.Uuid
  tenantId  String @map("tenant_id") @db.Uuid
  arbrainId String @map("arbrain_id")
  sku       Int
  nome      String

  syncedAt    DateTime @map("synced_at")
  lastSeenAt  DateTime @map("last_seen_at")
  payloadHash String?  @map("payload_hash")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, arbrainId])
  @@index([tenantId, sku])
  @@index([tenantId, nome])
  @@map("bancos")
}

model SyncRun {
  id       String        @id @default(uuid()) @db.Uuid
  tenantId String        @map("tenant_id") @db.Uuid
  entity   String
  status   SyncRunStatus @default(RUNNING)

  startedAt  DateTime  @default(now()) @map("started_at")
  finishedAt DateTime? @map("finished_at")

  totalRecords     Int @default(0) @map("total_records")
  processedRecords Int @default(0) @map("processed_records")
  changedRecords   Int @default(0) @map("changed_records")
  unchangedRecords Int @default(0) @map("unchanged_records")
  errorCount       Int @default(0) @map("error_count")

  errorMessage String? @map("error_message") @db.Text

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  errors SyncError[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tenantId, entity, startedAt])
  @@index([status])
  @@map("sync_runs")
}

model SyncError {
  id        String @id @default(uuid()) @db.Uuid
  syncRunId String @map("sync_run_id") @db.Uuid

  externalId String? @map("external_id")
  message    String  @db.Text
  details    Json?

  syncRun SyncRun @relation(fields: [syncRunId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([syncRunId])
  @@map("sync_errors")
}

model SyncCursor {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String  @map("tenant_id") @db.Uuid
  entity   String
  cursor   String?

  lastSuccessfulRunAt DateTime? @map("last_successful_run_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, entity])
  @@map("sync_cursors")
}

model Empresa {
  id        String @id @default(uuid()) @db.Uuid
  tenantId  String @map("tenant_id") @db.Uuid
  arbrainId String @map("arbrain_id")
  sku       Int
  nome      String

  syncedAt    DateTime @map("synced_at")
  lastSeenAt  DateTime @map("last_seen_at")
  payloadHash String?  @map("payload_hash")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, arbrainId])
  @@unique([tenantId, sku])
  @@index([tenantId, nome])
  @@map("empresas")
}

model BotnextAccount {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  companyId    String  @unique @map("company_id") @db.Uuid
  name         String
  channelPhone String? @map("channel_phone")
  active       Boolean @default(true)

  tenant                    Tenant                            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  webhookEvents             BotnextWebhookEvent[]
  conversations             BotnextConversation[]
  outboundMessages          BotnextOutboundMessage[]
  pedidoConfirmadoSnapshots BotnextPedidoConfirmadoSnapshot[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, id])
  @@index([tenantId, active])
  @@map("botnext_accounts")
}

enum BotnextWebhookStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  IGNORED
  FAILED
}

model BotnextWebhookEvent {
  id               String  @id @default(uuid()) @db.Uuid
  tenantId         String  @map("tenant_id") @db.Uuid
  clienteId        String? @map("cliente_id") @db.Uuid
  botnextAccountId String? @map("botnext_account_id") @db.Uuid

  eventType         String  @map("event_type")
  externalMessageId String  @map("external_message_id")
  companyId         String  @map("company_id")
  sessionId         String? @map("session_id")

  messageType    String? @map("message_type")
  direction      String?
  senderPhone    String? @map("sender_phone")
  recipientPhone String? @map("recipient_phone")
  messageText    String? @map("message_text") @db.Text

  eventDate DateTime? @map("event_date")
  payload   Json

  status       BotnextWebhookStatus @default(RECEIVED)
  processedAt  DateTime?            @map("processed_at")
  errorMessage String?              @map("error_message") @db.Text

  processingToken      String?   @map("processing_token") @db.Uuid
  processingWorker     String?   @map("processing_worker")
  processingLeaseUntil DateTime? @map("processing_lease_until")
  processingAttempts   Int       @default(0) @map("processing_attempts")

  enqueueToken      String?   @map("enqueue_token") @db.Uuid
  enqueueLeaseUntil DateTime? @map("enqueue_lease_until")
  enqueuedAt        DateTime? @map("enqueued_at")

  // Identidade canônica é nullable para preservar eventos históricos. Novos
  // eventos versionados serão vinculados pela aplicação antes da automação.
  identityVersion          String? @map("identity_version")
  senderPhoneNormalized    String? @map("sender_phone_normalized")
  recipientPhoneNormalized String? @map("recipient_phone_normalized")

  // Ordem durável de ingresso e geração do job BullMQ. A sequência será
  // preenchida apenas para novos eventos; históricos permanecem sem backfill.
  ingressSequence BigInt? @unique @default(dbgenerated("nextval('botnext_webhook_ingress_sequence_seq'::regclass)")) @map("ingress_sequence")
  queueGeneration Int     @default(0) @map("queue_generation")

  tenant                   Tenant                           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cliente                  Cliente?                         @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  BotnextAccount           BotnextAccount?                  @relation(fields: [botnextAccountId], references: [id])
  conversationMessage      BotnextConversationMessage?
  outboundMessages         BotnextOutboundMessage[]
  pedidoConfirmadoSnapshot BotnextPedidoConfirmadoSnapshot?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, companyId, eventType, externalMessageId])
  @@unique([tenantId, id])
  @@index([tenantId, status])
  @@index([status, processingLeaseUntil])
  @@index([status, enqueueLeaseUntil])
  @@index([tenantId, sessionId])
  @@index([tenantId, clienteId])
  @@index([senderPhone])
  @@index([createdAt])
  @@index([botnextAccountId])
  @@index([botnextAccountId, sessionId, status, ingressSequence])
  @@map("botnext_webhook_events")
}

enum BotnextConversationStatus {
  ACTIVE
  WAITING_CUSTOMER
  WAITING_CONFIRMATION
  HUMAN_HANDOFF
  COMPLETED
  CANCELLED
  FAILED
}

enum BotnextConversationMessageRole {
  CUSTOMER
  ASSISTANT
  SYSTEM
  HUMAN
}

enum BotnextConversationIntent {
  FAZER_PEDIDO
  NAO_DESEJA_PEDIDO
  DUVIDA
  ATENDIMENTO_HUMANO
  ALTERACAO_CADASTRAL
  RECLAMACAO
  FORA_DE_CONTEXTO
}

enum BotnextRoutingAction {
  INICIAR_PEDIDO
  ENCERRAR_SEM_PEDIDO
  RESPONDER_DUVIDA
  ENCAMINHAR_ATENDIMENTO_HUMANO
  SOLICITAR_MAIS_CONTEXTO
}

model BotnextConversation {
  id               String  @id @default(uuid()) @db.Uuid
  tenantId         String  @map("tenant_id") @db.Uuid
  clienteId        String? @map("cliente_id") @db.Uuid
  botnextAccountId String  @map("botnext_account_id") @db.Uuid

  sessionId String                    @map("session_id")
  status    BotnextConversationStatus @default(ACTIVE)

  // Nullable somente para compatibilidade com conversas históricas.
  identityVersion          String? @map("identity_version")
  senderPhoneNormalized    String? @map("sender_phone_normalized")
  recipientPhoneNormalized String? @map("recipient_phone_normalized")

  intent               BotnextConversationIntent?
  intentConfidence     Float?                     @map("intent_confidence")
  intentUpdatedAt      DateTime?                  @map("intent_updated_at")
  requiresHumanHandoff Boolean                    @default(false) @map("requires_human_handoff")

  lastMessageAt DateTime  @default(now()) @map("last_message_at")
  closedAt      DateTime? @map("closed_at")

  tenant                    Tenant                            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cliente                   Cliente?                          @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  botnextAccount            BotnextAccount                    @relation(fields: [botnextAccountId], references: [id])
  messages                  BotnextConversationMessage[]
  pedidoExtracao            BotnextPedidoExtracao[]
  outboundMessages          BotnextOutboundMessage[]
  pedidoConfirmadoSnapshots BotnextPedidoConfirmadoSnapshot[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([botnextAccountId, sessionId])
  // Alvo da FK composta (tenant_id, conversation_id) de botnext_pedido_extracao
  // e botnext_pedido_rascunho — garante que o pedido e a conversa são do mesmo
  // tenant. Redundante quanto à unicidade (id já é PK), obrigatório como alvo de FK.
  @@unique([tenantId, id])
  @@index([tenantId, status])
  @@index([tenantId, clienteId])
  @@index([tenantId, intent])
  @@index([lastMessageAt])
  @@map("botnext_conversations")
}

model BotnextConversationMessage {
  id                String  @id @default(uuid()) @db.Uuid
  conversationId    String  @map("conversation_id") @db.Uuid
  webhookEventId    String? @unique @map("webhook_event_id") @db.Uuid
  externalMessageId String? @map("external_message_id")

  role        BotnextConversationMessageRole
  messageType String?                        @map("message_type")
  text        String?                        @db.Text
  eventDate   DateTime?                      @map("event_date")

  detectedIntent        BotnextConversationIntent? @map("detected_intent")
  intentConfidence      Float?                     @map("intent_confidence")
  intentReason          String?                    @map("intent_reason") @db.Text
  requiresHumanHandoff  Boolean?                   @map("requires_human_handoff")
  classificationModel   String?                    @map("classification_model")
  classificationVersion String?                    @map("classification_version")
  classifiedAt          DateTime?                  @map("classified_at")

  routingAction  BotnextRoutingAction?      @map("routing_action")
  routingReason  String?                    @map("routing_reason") @db.Text
  routingStatus  BotnextConversationStatus? @map("routing_status")
  routingVersion String?                    @map("routing_version")
  routedAt       DateTime?                  @map("routed_at")

  conversation   BotnextConversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  webhookEvent   BotnextWebhookEvent?   @relation(fields: [webhookEventId], references: [id], onDelete: SetNull)
  pedidoExtracao BotnextPedidoExtracao?

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([conversationId, externalMessageId])
  // Alvo da FK composta (conversation_id, source_message_id) de
  // botnext_pedido_extracao — garante que a mensagem de origem pertence à
  // mesma conversa da extração. Obrigatório como alvo de FK.
  @@unique([conversationId, id])
  @@index([conversationId, createdAt])
  @@index([detectedIntent, classifiedAt])
  @@index([routingAction, routedAt])
  @@map("botnext_conversation_messages")
}

// ---------------------------------------------------------------------------
// Pedidos: extração (saída bruta do extractor) x rascunho (pedido normalizado
// e resolvido, pronto para revisão/despacho). Entidades separadas de propósito:
//
//  - A extração é a leitura imutável de UMA mensagem do cliente. O extractor
//    recebe somente a mensagem atual (não o histórico da conversa); portanto
//    há no máximo uma extração por mensagem (unique em source_message_id) e
//    source_hash é o hash do texto imutável dessa mensagem.
//  - O rascunho deriva de uma extração e evolui por uma máquina de estados
//    até o despacho para o n8n.
//
// Consistência multi-tenant é garantida pelo PostgreSQL via FKs compostas,
// não pela aplicação (ver comentários @@unique nos modelos-alvo).
// ---------------------------------------------------------------------------

enum BotnextPedidoExtracaoStatus {
  PENDENTE
  PROCESSANDO
  EXTRAIDO
  FALHOU
}

enum BotnextPedidoRascunhoStatus {
  RASCUNHO
  PRONTO
  CONFIRMADO
  DESPACHADO
  CANCELADO
  FALHOU
}

model BotnextPedidoExtracao {
  id              String @id @default(uuid()) @db.Uuid
  tenantId        String @map("tenant_id") @db.Uuid
  conversationId  String @map("conversation_id") @db.Uuid
  sourceMessageId String @map("source_message_id") @db.Uuid

  status BotnextPedidoExtracaoStatus @default(PENDENTE)

  // Entrada imutável: sourceHash é o hash (ex.: sha256) do texto da mensagem
  // atual usado como entrada do extractor. inputText guarda opcionalmente a
  // string exata enviada ao modelo (auditoria/depuração).
  sourceHash String  @map("source_hash")
  inputText  String? @map("input_text") @db.Text

  // Resultado da extração (preenchido pelo extractor em etapa futura)
  itensExtraidos   Json?     @map("itens_extraidos")
  observacoes      String?   @map("observacoes") @db.Text
  extractorModel   String?   @map("extractor_model")
  extractorVersion String?   @map("extractor_version")
  promptVersion    String?   @map("prompt_version")
  confianca        Float?    @map("confianca")
  extractedAt      DateTime? @map("extracted_at")

  // CAS / concorrência: revision para optimistic locking; lease para
  // processamento exclusivo por worker.
  revision             Int       @default(0)
  processingToken      String?   @map("processing_token") @db.Uuid
  processingWorker     String?   @map("processing_worker")
  processingLeaseUntil DateTime? @map("processing_lease_until")
  processingAttempts   Int       @default(0) @map("processing_attempts")

  errorMessage String? @map("error_message") @db.Text

  // tenant: existência do tenant. conversation: FK composta garante que a
  // conversa é do mesmo tenant. sourceMessage: FK composta garante que a
  // mensagem de origem é da mesma conversa (e, por transitividade, do tenant).
  tenant                    Tenant                            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation              BotnextConversation               @relation(fields: [tenantId, conversationId], references: [tenantId, id], onDelete: Cascade)
  sourceMessage             BotnextConversationMessage        @relation(fields: [conversationId, sourceMessageId], references: [conversationId, id], onDelete: Cascade)
  rascunho                  BotnextPedidoRascunho?
  pedidoConfirmadoSnapshots BotnextPedidoConfirmadoSnapshot[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Idempotência: no máximo uma extração por mensagem de origem. É também o
  // alvo unique exigido pela relação 1:1 sourceMessage e, com conversation_id
  // à esquerda, suporta o CASCADE da FK (tenant_id, conversation_id) e as
  // consultas por conversa.
  @@unique([conversationId, sourceMessageId])
  // Alvo da FK composta (tenant_id, extracao_id) de botnext_pedido_rascunho.
  // Redundante quanto à unicidade (id já é PK), obrigatório como alvo de FK.
  @@unique([tenantId, id])
  @@index([tenantId, status])
  @@index([status, processingLeaseUntil])
  @@map("botnext_pedido_extracao")
}

model BotnextPedidoRascunho {
  id         String @id @default(uuid()) @db.Uuid
  tenantId   String @map("tenant_id") @db.Uuid
  extracaoId String @map("extracao_id") @db.Uuid

  status BotnextPedidoRascunhoStatus @default(RASCUNHO)

  // Conteúdo do rascunho — a resolução de catálogo será feita em etapa futura.
  itens              Json?   @map("itens")
  totalItens         Int     @default(0) @map("total_itens")
  itensResolvidos    Int     @default(0) @map("itens_resolvidos")
  itensNaoResolvidos Int     @default(0) @map("itens_nao_resolvidos")
  observacoes        String? @map("observacoes") @db.Text

  // CAS / concorrência
  revision Int @default(0)

  // Despacho para n8n — efeito externo, desativado nesta etapa. dispatchKey
  // garante idempotência do envio; lease garante despacho exclusivo.
  dispatchKey        String?   @map("dispatch_key")
  dispatchToken      String?   @map("dispatch_token") @db.Uuid
  dispatchWorker     String?   @map("dispatch_worker")
  dispatchLeaseUntil DateTime? @map("dispatch_lease_until")
  dispatchAttempts   Int       @default(0) @map("dispatch_attempts")
  dispatchedAt       DateTime? @map("dispatched_at")

  errorMessage String? @map("error_message") @db.Text

  // tenant: existência do tenant. extracao: FK composta (tenant_id, extracao_id)
  // garante que o rascunho e a extração são do mesmo tenant. A conversa/mensagem
  // do rascunho são obtidas via extracao.
  tenant             Tenant                           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  extracao           BotnextPedidoExtracao            @relation(fields: [tenantId, extracaoId], references: [tenantId, id], onDelete: Cascade)
  outboundMessages   BotnextOutboundMessage[]
  confirmadoSnapshot BotnextPedidoConfirmadoSnapshot?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Idempotência: no máximo um rascunho por extração. É também o alvo unique
  // exigido pela relação 1:1 extracao e suporta o CASCADE da FK
  // (tenant_id, extracao_id) a partir de botnext_pedido_extracao.
  @@unique([tenantId, extracaoId])
  @@unique([tenantId, id])
  // Idempotência do envio ao n8n (dispatchKey nulo não conflita no Postgres).
  @@unique([tenantId, dispatchKey])
  @@index([tenantId, status])
  @@index([status, dispatchLeaseUntil])
  @@map("botnext_pedido_rascunho")
}

enum BotnextOutboundStatus {
  PENDING
  SENDING
  SENT
  FAILED
  UNCERTAIN
}

enum BotnextOutboundKind {
  TEXT
  TEMPLATE
}

// Outbox durável para todo efeito HTTP direcionado ao BotNext. O payload não
// contém credenciais; Authorization continua sendo obtida do ambiente.
model BotnextOutboundMessage {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  botnextAccountId     String  @map("botnext_account_id") @db.Uuid
  conversationId       String? @map("conversation_id") @db.Uuid
  clienteId            String? @map("cliente_id") @db.Uuid
  sourceWebhookEventId String? @map("source_webhook_event_id") @db.Uuid
  pedidoRascunhoId     String? @map("pedido_rascunho_id") @db.Uuid

  kind    BotnextOutboundKind
  purpose String

  idempotencyKey String @map("idempotency_key")
  requestHash    String @map("request_hash")

  fromPhoneNormalized String @map("from_phone_normalized")
  toPhoneNormalized   String @map("to_phone_normalized")
  payload             Json

  status        BotnextOutboundStatus @default(PENDING)
  fencingToken  BigInt                @default(0) @map("fencing_token")
  claimToken    String?               @map("claim_token") @db.Uuid
  claimWorker   String?               @map("claim_worker")
  leaseUntil    DateTime?             @map("lease_until")
  attempts      Int                   @default(0)
  nextAttemptAt DateTime?             @default(now()) @map("next_attempt_at")

  lastAttemptAt DateTime? @map("last_attempt_at")
  startedAt     DateTime? @map("started_at")
  sentAt        DateTime? @map("sent_at")
  failedAt      DateTime? @map("failed_at")
  uncertainAt   DateTime? @map("uncertain_at")

  lastHttpStatus    Int?    @map("last_http_status")
  providerMessageId String? @map("provider_message_id")
  providerStatus    String? @map("provider_status")
  errorCode         String? @map("error_code")
  errorMessage      String? @map("error_message") @db.Text

  tenant             Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  botnextAccount     BotnextAccount         @relation(fields: [tenantId, botnextAccountId], references: [tenantId, id], onDelete: Restrict)
  conversation       BotnextConversation?   @relation(fields: [tenantId, conversationId], references: [tenantId, id], onDelete: Restrict)
  cliente            Cliente?               @relation(fields: [tenantId, clienteId], references: [tenantId, id], onDelete: Restrict)
  sourceWebhookEvent BotnextWebhookEvent?   @relation(fields: [tenantId, sourceWebhookEventId], references: [tenantId, id], onDelete: Restrict)
  pedidoRascunho     BotnextPedidoRascunho? @relation(fields: [tenantId, pedidoRascunhoId], references: [tenantId, id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, idempotencyKey])
  @@unique([tenantId, sourceWebhookEventId, purpose])
  @@index([status, nextAttemptAt, createdAt])
  @@index([status, leaseUntil])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, conversationId, createdAt])
  @@map("botnext_outbound_messages")
}

// Snapshot append-only do contrato entregue ao n8n. O lease, fencing,
// tentativas e conclusão do dispatch continuam no rascunho já existente.
model BotnextPedidoConfirmadoSnapshot {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  rascunhoId          String @map("rascunho_id") @db.Uuid
  confirmationEventId String @map("confirmation_event_id") @db.Uuid
  botnextAccountId    String @map("botnext_account_id") @db.Uuid
  conversationId      String @map("conversation_id") @db.Uuid
  extracaoId          String @map("extracao_id") @db.Uuid
  clienteId           String @map("cliente_id") @db.Uuid

  senderPhoneNormalized String @map("sender_phone_normalized")
  clienteArbrainId      String @map("cliente_arbrain_id")

  contractVersion   String   @map("contract_version")
  keyVersion        String   @map("key_version")
  dispatchKey       String   @map("dispatch_key")
  payload           Json
  payloadSha256     String   @map("payload_sha256")
  confirmedRevision Int      @map("confirmed_revision")
  confirmedAt       DateTime @map("confirmed_at")

  tenant            Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  rascunho          BotnextPedidoRascunho @relation(fields: [tenantId, rascunhoId], references: [tenantId, id], onDelete: Restrict)
  confirmationEvent BotnextWebhookEvent   @relation(fields: [tenantId, confirmationEventId], references: [tenantId, id], onDelete: Restrict)
  botnextAccount    BotnextAccount        @relation(fields: [tenantId, botnextAccountId], references: [tenantId, id], onDelete: Restrict)
  conversation      BotnextConversation   @relation(fields: [tenantId, conversationId], references: [tenantId, id], onDelete: Restrict)
  extracao          BotnextPedidoExtracao @relation(fields: [tenantId, extracaoId], references: [tenantId, id], onDelete: Restrict)
  cliente           Cliente               @relation(fields: [tenantId, clienteId], references: [tenantId, id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([tenantId, rascunhoId])
  @@unique([tenantId, dispatchKey])
  @@unique([tenantId, confirmationEventId])
  @@index([tenantId, confirmedAt])
  @@map("botnext_pedido_confirmado_snapshots")
}

// Alias de produto: texto (normalizado) que resolve para exatamente um
// produto dentro de um tenant. Todo ProdutoAlias representa, por definição,
// uma resolução ALIAS_DIRETO — a origem da resolução não é modelada aqui,
// pertence ao resultado da resolução do item (etapa futura). Não são criados
// automaticamente e não há alias genérico. Único por (tenant + texto).
model ProdutoAlias {
  id        String @id @default(uuid()) @db.Uuid
  tenantId  String @map("tenant_id") @db.Uuid
  produtoId String @map("produto_id") @db.Uuid

  alias            String
  aliasNormalizado String @map("alias_normalizado")

  ativo Boolean @default(true)

  // FK composta (tenant_id, produto_id) -> produtos(tenant_id, id) garante
  // que o alias e o produto pertencem ao mesmo tenant.
  produto Produto @relation(fields: [tenantId, produtoId], references: [tenantId, id], onDelete: Cascade)
  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, aliasNormalizado])
  // Suporta o CASCADE da FK composta (tenant_id, produto_id) e consultas
  // "aliases do produto X".
  @@index([tenantId, produtoId])
  @@map("produto_aliases")
}
