    "node-cron": "^4.6.0",
    "openai": "^7.8.0",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.2.1",
    "prisma": "^6.12.0",
    "vitest": "^5.0.0"
